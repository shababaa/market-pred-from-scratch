# Copy to .env only for local development. Never commit real credentials.
MARKET_API_TOKEN=replace-with-a-long-random-token
TWELVE_DATA_API_KEY=
TWELVE_DATA_REQUESTS_PER_MINUTE=8

# Native marketserver only; the Ollama adapter permits numeric loopback URLs.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
